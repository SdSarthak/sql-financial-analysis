# Copy to .env and adjust. .env is git-ignored - never commit real credentials.

# Where the client book lives. Paths are relative to the working directory.
# SQLite (default, no server required):
SQLFIN_DATABASE_URL=sqlite:///data/financial.db

# PostgreSQL (requires: pip install "psycopg[binary]>=3.1")
# SQLFIN_DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE

# Where `python -m sqlfin report` writes report.md and the per-analysis CSV extracts.
SQLFIN_REPORT_DIR=reports
